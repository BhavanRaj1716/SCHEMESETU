# ---- App ----
APP_ENV=development                # development | production
APP_VERSION=1.0.0
# Comma-separated list of allowed frontend origins. Never "*" in production.
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# Zero-setup local default: SQLite, no service to install. Semantic search runs as an in-process
# cosine search on this backend (see app/services/semantic_search.py) - fine for development.
DATABASE_URL=sqlite:///./schemesetu.db
# For production / pgvector-accelerated search, use PostgreSQL instead, e.g.:
# DATABASE_URL=postgresql+psycopg://schemesetu:CHANGE_ME@localhost:5432/schemesetu

# ---- Embeddings ----
# sentence-transformers = real semantic model (needs requirements-ml.txt)
# hashing               = dependency-free LEXICAL fallback for tests/offline demos (not truly semantic)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
SEMANTIC_TOP_K=5
SEMANTIC_MIN_SIMILARITY=0.05

# ---- Auth ----
# none     = auth endpoints return 401/disabled (protected routes unavailable)
# dev      = LOCAL DEVELOPMENT ONLY. Trusts any bearer token as a user id, no password/signature
#            check. Refuses to start if APP_ENV=production. Use this to build/test the frontend's
#            saved-schemes and profile screens before Firebase is wired up.
# firebase = verify real Firebase ID tokens sent by the frontend (no passwords stored here)
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
# Path to a service-account JSON OR leave empty to use Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Official hand-off ----
PM_SURAJ_URL=https://pmsuraj.dosje.gov.in/
